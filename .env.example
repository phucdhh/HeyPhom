# ============================================
# HeyPhom Environment Configuration
# ============================================

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=4444
NODE_ENV=production
HOST=0.0.0.0

# Frontend port (if needed)
FRONTEND_PORT=4445

# --------------------------------------------
# Paths - IMPORTANT: Update these paths!
# --------------------------------------------
ENGINE_PATH=/Users/mac/HeyPhom/core-engine/.build/release/heyphom-cli
UPLOAD_DIR=/Users/mac/HeyPhom/backend-api/uploads
EXPORT_DIR=/Users/mac/HeyPhom/backend-api/exports
SESSION_DIR=/Users/mac/HeyPhom/backend-api/sessions
LOG_DIR=/Users/mac/HeyPhom/backend-api/logs
TEMP_DIR=/Users/mac/HeyPhom/backend-api/temp

# --------------------------------------------
# Processing Limits
# --------------------------------------------
# Maximum number of images per processing session
MAX_IMAGES_PER_SESSION=300

# Maximum file size per image (in MB)
MAX_FILE_SIZE_MB=10

# Maximum total upload size per session (in GB)
MAX_TOTAL_SIZE_GB=3

# Session timeout (in hours)
SESSION_TIMEOUT_HOURS=24

# Processing quality: low, medium, high, ultra
DEFAULT_QUALITY=high

# Supported image formats (comma-separated)
ALLOWED_FORMATS=jpg,jpeg,png,heic,heif

# --------------------------------------------
# Queue Configuration (Redis - Optional)
# --------------------------------------------
# Enable Redis queue for concurrent processing
USE_REDIS_QUEUE=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Maximum concurrent jobs (1 recommended for M2 24GB)
MAX_CONCURRENT_JOBS=1

# Job timeout (in seconds)
JOB_TIMEOUT_SECONDS=3600

# --------------------------------------------
# Security
# --------------------------------------------
# Require API key for requests
API_KEY_REQUIRED=false
API_KEY=your-secret-api-key-change-this

# CORS settings
ALLOWED_ORIGINS=*
# For production, use specific domain:
# ALLOWED_ORIGINS=https://heyphom.truyenthong.edu.vn,https://www.heyphom.truyenthong.edu.vn

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Request size limits
MAX_REQUEST_SIZE=3gb
MAX_FIELD_SIZE=25mb

# --------------------------------------------
# Monitoring & Metrics
# --------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=3336

# Enable detailed logging
LOG_LEVEL=info
# Options: error, warn, info, debug, trace

# Log rotation
LOG_MAX_SIZE=50m
LOG_MAX_FILES=10

# --------------------------------------------
# Cleanup Configuration
# --------------------------------------------
AUTO_CLEANUP_ENABLED=true

# Clean up uploaded files after X hours
CLEANUP_AFTER_HOURS=24

# Run cleanup every X minutes
CLEANUP_INTERVAL_MINUTES=60

# Keep successful exports for X days
KEEP_EXPORTS_DAYS=7

# --------------------------------------------
# Email Notifications (Optional)
# --------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=admin@heyphom.truyenthong.edu.vn

# --------------------------------------------
# Webhook Configuration (Optional)
# --------------------------------------------
ENABLE_WEBHOOKS=false
WEBHOOK_PORT=3337
WEBHOOK_SECRET=your-webhook-secret

# --------------------------------------------
# Development Settings
# --------------------------------------------
# Enable debug mode
DEBUG=false

# Mock processing (for testing without running actual engine)
MOCK_PROCESSING=false

# Test mode (skip cleanup)
TEST_MODE=false

# --------------------------------------------
# Apple Silicon Optimization
# --------------------------------------------
# Use Metal Performance Shaders
USE_METAL_ACCELERATION=true

# Use Apple Neural Engine for masking
USE_ANE_MASKING=true

# Memory pressure threshold (percentage)
MEMORY_PRESSURE_THRESHOLD=90

# --------------------------------------------
# Export Formats
# --------------------------------------------
# Available formats: usdz, obj, stl, ply, gltf
DEFAULT_EXPORT_FORMATS=usdz,obj,stl

# Texture resolution: low (1024), medium (2048), high (4096)
TEXTURE_RESOLUTION=medium

# Mesh optimization
OPTIMIZE_MESH=true
TARGET_POLY_COUNT=100000

# --------------------------------------------
# Cloudflare Configuration (for reference)
# --------------------------------------------
# Domain: heyphom.truyenthong.edu.vn
# Tunnel name: heyphom-tunnel
# Local service: http://localhost:3333

# --------------------------------------------
# Backup Configuration (Optional)
# --------------------------------------------
ENABLE_BACKUP=false
BACKUP_DIR=/Users/mac/HeyPhom/backups
BACKUP_RETENTION_DAYS=30

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_3D_PREVIEW=true
ENABLE_PROGRESS_TRACKING=true
ENABLE_BATCH_PROCESSING=false
ENABLE_PRIORITY_QUEUE=false
